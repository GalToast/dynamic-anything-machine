{
  "profile_name": "code",
  "description": "Profile for code editing and sweep tasks with controlled write access and limited shell commands",
  "max_nodes": 40,
  "max_depth": 7,
  "max_parallelism": 4,
  "max_children_per_node": 3,
  "max_runtime_seconds": 900,
  "allowed_node_types": ["planner", "retriever", "scorer", "router", "critic", "worker", "integrator", "reviewer", "editor", "searcher"],
  "required_node_types": ["critic", "reviewer"],
  "allowed_tools": ["read_file", "list_directory", "search", "grep", "glob", "read_json", "read_csv", "write_file", "edit_file"],
  "forbidden_tools": ["shell", "delete_file", "deploy", "payment"],
  "side_effect_requires_approval": ["shell_command", "delete_file", "install", "deploy", "file_write", "browser_action", "login_flow", "send_message", "submit_application", "network_call", "expose_secret"],
  "max_delegation_depth": 3,
  "require_critic_before_output": true,
  "require_reviewer": true,
  "allow_arbitrary_shell": false,
  "allow_arbitrary_file_write": true,
  "allow_network_calls": false,
  "secret_files": [".env", "*.key", "*.pem", "credentials.json", "secrets.json", "token", "*.token", "cookie"],
  "safe_mode": true,
  "owned_paths": ["src/", "lib/", "tests/", "scripts/", "config/"],
  "inline_shell_allowed": ["git status", "git diff", "npm test", "python -m pytest", "ruff check", "ruff format --check"]
}