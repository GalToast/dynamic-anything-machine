{
  "profile_name": "research",
  "description": "Profile for research and discovery tasks with network access enabled for web fetches and searches",
  "max_nodes": 30,
  "max_depth": 5,
  "max_parallelism": 5,
  "max_children_per_node": 4,
  "max_runtime_seconds": 1200,
  "allowed_node_types": ["planner", "retriever", "scorer", "router", "critic", "worker", "integrator", "reviewer", "searcher", "fetcher"],
  "required_node_types": ["critic", "reviewer"],
  "allowed_tools": ["read_file", "list_directory", "search", "grep", "glob", "read_json", "read_csv", "fetch_url", "search_web"],
  "forbidden_tools": ["shell", "write_file", "delete_file", "deploy", "send_message", "submit_application"],
  "side_effect_requires_approval": ["network_call", "file_write", "browser_action", "login_flow", "send_message", "submit_application", "install", "deploy", "expose_secret"],
  "max_delegation_depth": 3,
  "require_critic_before_output": true,
  "require_reviewer": true,
  "allow_arbitrary_shell": false,
  "allow_arbitrary_file_write": false,
  "allow_network_calls": true,
  "secret_files": [".env", "*.key", "*.pem", "credentials.json", "secrets.json", "token", "*.token", "cookie"],
  "safe_mode": true,
  "web_fetch_user_agent": "DynamicGraphCompiler/1.0 Research Agent",
  "rate_limit_requests_per_minute": 30
}