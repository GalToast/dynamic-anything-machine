{
  "profile_name": "default",
  "description": "Safe readonly default profile for general agent graph execution with mandatory review gates",
  "max_nodes": 20,
  "max_depth": 5,
  "max_parallelism": 3,
  "max_children_per_node": 2,
  "max_runtime_seconds": 600,
  "allowed_node_types": ["planner", "retriever", "scorer", "router", "critic", "worker", "integrator", "reviewer"],
  "required_node_types": ["critic", "reviewer"],
  "allowed_tools": ["read_file", "list_directory", "search", "grep", "glob", "read_json", "read_csv"],
  "forbidden_tools": ["shell", "bash", "write_file", "delete_file", "execute", "deploy", "send_message", "submit"],
  "side_effect_requires_approval": ["file_write", "shell_command", "browser_action", "login_flow", "send_message", "submit_application", "network_call", "install", "deploy", "payment", "delete_file", "expose_secret"],
  "max_delegation_depth": 2,
  "require_critic_before_output": true,
  "require_reviewer": true,
  "allow_arbitrary_shell": false,
  "allow_arbitrary_file_write": false,
  "allow_network_calls": false,
  "secret_files": [".env", "*.key", "*.pem", "credentials.json", "secrets.json", "token", "*.token", "cookie"],
  "safe_mode": true
}