{
  "profile_name": "high_risk",
  "description": "Highly restrictive profile for sensitive operations with mandatory human approval gates on all side effects",
  "max_nodes": 15,
  "max_depth": 3,
  "max_parallelism": 2,
  "max_children_per_node": 1,
  "max_runtime_seconds": 300,
  "allowed_node_types": ["planner", "retriever", "scorer", "router", "critic", "worker", "integrator", "reviewer", "approver"],
  "required_node_types": ["critic", "reviewer", "approver"],
  "allowed_tools": ["read_file", "list_directory"],
  "forbidden_tools": ["shell", "bash", "write_file", "execute", "deploy", "send_message", "submit", "delete_file", "install", "network_call"],
  "side_effect_requires_approval": ["file_write", "shell_command", "browser_action", "login_flow", "send_message", "submit_application", "network_call", "install", "deploy", "payment", "delete_file", "expose_secret"],
  "max_delegation_depth": 1,
  "require_critic_before_output": true,
  "require_reviewer": true,
  "allow_arbitrary_shell": false,
  "allow_arbitrary_file_write": false,
  "allow_network_calls": false,
  "secret_files": [".env", "*.key", "*.pem", "credentials.json", "secrets.json", "token", "*.token", "cookie", ".aws", ".gcp", ".azure"],
  "safe_mode": true,
  "require_approver_on_all_outputs": true,
  "audit_logging": true
}